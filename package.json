{
    "version": "1.4.8",
    "homepage": "https://github.com/nativescript-community/ui-massifmaps#readme",
    "bugs": {
        "url": "https://github.com/nativescript-community/ui-massifmaps/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nativescript-community/ui-massifmaps.git"
    },
    "license": "ISC",
    "author": "",
    "scripts": {
        "build": "lerna run build",
        "build.all": "npm run build",
        "clean": "rimraf -g 'packages/**/*.d.ts' 'packages/**/*.tsbuildinfo' 'packages/**/*.js' 'packages/**/*.mjs' 'packages/**/*.js.map' 'packages/**/*.mjs.map' 'packages/**/*.metada' 'packages/**/angular/ng-package.json'",
        "commitmsg": "commitlint -e $GIT_PARAMS",
        "demo.svelte.android": "cd ./demo-svelte && ns run android --no-hmr --env.watchNodeModules",
        "demo.svelte.ios": "cd ./demo-svelte && ns run ios --no-hmr --env.watchNodeModules",
        "demo.svelte.clean": "cd ./demo-svelte && ns clean",
        "demo.vue.android": "cd ./demo-vue && ns run android --no-hmr --env.watchNodeModules",
        "demo.vue.ios": "cd ./demo-vue && ns run ios --no-hmr --env.watchNodeModules",
        "demo.vue.clean": "cd ./demo-vue && ns clean",
        "postinstall": "npm run setup",
        "publish": "npm run setup && npm run clean && npm run build.all && npm run readme && npm run doc && npm run commit_readme_doc_changes && lerna publish",
        "readme": "lerna run readme && node ./tools/readme.js",
        "setup": "npm run submodules && ts-patch install && npm run hooks",
        "hooks": "node ./demo-snippets/scripts/install-hooks.js",
        "start": "./node_modules/.bin/ntl -A -s 15 -o",
        "submodules": "git submodule update --init",
        "bindings": "node ./scripts/bindings/index.mjs",
        "bindings.check": "tsc -p ./scripts/bindings/typecheck/tsconfig.json",
        "bindings.coverage": "node ./scripts/bindings/index.mjs --coverage",
        "bindings.migrate": "node ./scripts/bindings/index.mjs --migrate-all",
        "typings": "node ./scripts/typings/index.mjs",
        "typings.android": "node ./scripts/typings/index.mjs android",
        "typings.ios": "node ./scripts/typings/index.mjs ios",
        "typings.api.check": "tsc -p ./scripts/api-typings/typecheck/tsconfig.json",
        "examples": "node ./scripts/examples/index.mjs",
        "examples.check": "node ./scripts/examples/check.mjs",
        "sync": "node ./tools/sync.mjs",
        "update": "node ./tools/update.js",
        "fullclean": "npm run clean && rimraf -g 'packages/**/node_modules' 'demo-*/hooks' 'demo-*/node_modules' 'package-lock.json' 'pnpm-lock.yaml' 'node_modules'",
        "doc": "node tools/builddoc.mjs",
        "commit_readme_doc_changes": "git add docs/** *.md ; git commit -m \"readme/doc\" ; echo \"commit readme doc done\""
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ]
    },
    "dependencies": {
        "@nativescript-community/plugin-seed-tools": "portal:tools",
        "@nativescript-community/template-snippet": "file:demo-snippets"
    },
    "ntl": {
        "descriptions": {
            "build": "Build the plugin",
            "build.all": "Build the plugin for all platforms",
            "clean": "Clean the local environment.",
            "demo.svelte.android": "Runs the Svelte demo on Android.",
            "demo.svelte.ios": "Runs the Svelte demo on iOS.",
            "demo.vue.android": "Runs the Vue demo on Android.",
            "demo.vue.ios": "Runs the Vue demo on iOS.",
            "typings.api.check": "Typecheck the surface API and its typing tests.",
            "examples": "Rebuild the example gallery from the SDK's example manifest.",
            "examples.check": "Typecheck every example's script against the plugin typings.",
            "watch": "Watch for changes in the plugin source and re-build."
        }
    },
    "engines": {
        "npm": "please use yarn or pnpm",
        "yarn": ">=1.19.1",
        "pnpm": ">=7.0.0",
        "node": "^14.20.0 || ^16.13.0 || >=18.10.0"
    },
    "workspaces": [
        "packages/*",
        "demo*"
    ],
    "packageManager": "yarn@4.10.2"
}
